<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The talk button and "Hey Box" record from the microphone. Nothing else is needed:
         Python, PyObjC and the web view run under the hardened runtime as they are. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
